<UserControl x:Class="ProjectChronos.Views.SimulationReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjectChronos.Views"
             xmlns:vm="clr-namespace:ProjectChronos.ViewModels"
             xmlns:conv="clr-namespace:ProjectChronos.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="800">
    <UserControl.Resources>
        <local:TimeToOffsetConverter x:Key="TimeToOffsetConverter" ThumbWidth="18.0"/>
        <!--<conv:PriorityToTagConverter x:Key="PriorityToTagConverter"/>-->
        <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <conv:EventTypeToColorConverter x:Key="EventColorConverter"/>

        <!-- 색상 리소스 -->
        <SolidColorBrush x:Key="PanelBackground" Color="#2d2d2d"/>
        <SolidColorBrush x:Key="WindowBackground" Color="#1e1e1e"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007acc"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ffffff"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#aaaaaa"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#444444"/>
        <SolidColorBrush x:Key="ControlHover" Color="#555555"/>
        <SolidColorBrush x:Key="ControlPressed" Color="#333333"/>
        
        <!-- 버튼 스타일 -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 슬라이더 스타일 -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- 트랙 (배경 투명 - 별도 Border로 위임) -->
                            <Border x:Name="TrackBackground" Grid.Row="1" Height="4" 
                                    Background="Transparent" CornerRadius="2" VerticalAlignment="Center"/>
                            
                            <!-- 선택 범위 (진행률) -->
                            <!-- 참고: 표준 WPF Slider는 PART_SelectionRange 없이 0부터 값까지의 '선택' 범위를 시각적으로 쉽게 지원하지 않습니다.
                                 간단하게 하기 위해 기본 트랙을 사용하되 썸(Thumb) 스타일을 적용합니다.
                                 '채워진' 느낌을 주려면 PART_SelectionRange나 별도 바인딩이 포함된 복잡한 템플릿이 필요합니다.
                                 여기서는 안정성을 위해 깔끔한 트랙과 썸을 유지합니다. -->
                            
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{StaticResource AccentColor}" Height="4" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2,0,0,2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" Height="4" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="18" Height="18" VerticalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{StaticResource TextPrimary}" Stroke="{StaticResource AccentColor}" StrokeThickness="2"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 콤보박스 스타일 (기본 다크) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="Foreground" Value="Black"/> <!-- Content usually black unless specific template -->
            <Setter Property="BorderBrush" Value="#666"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlPressed}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- 툴팁 스타일 -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="5" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    
    <Border Background="{StaticResource PanelBackground}" Padding="15" CornerRadius="8" Effect="{x:Null}">
        <!-- Optional Shadow Effect if desired, removed for clean look -->
        <!-- <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect> -->
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Timeline -->
                <RowDefinition Height="30"/>   <!-- Spacer (Text Overlay Area) -->
                <RowDefinition Height="Auto"/> <!-- Controls -->
            </Grid.RowDefinitions>

            <!-- 타임라인 영역 -->
            <!-- 
                 [구조 설명]
                 ItemsControl (마커)과 Slider의 상호작용을 위해 Z-Index를 신중하게 설정해야 합니다.
                 
                 - 마커(Markers)는 시각적으로 트랙 위에 표시되어야 합니다.
                 - 슬라이더(Slider)는 사용자가 드래그할 수 있어야 하므로 최상단에 위치해야 합니다.
                 - 그러나 슬라이더의 배경(Track)이 마커를 가리면 안 되므로, 슬라이더 배경을 투명하게 처리합니다.
            -->
            <Grid Grid.Row="0" Margin="0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 5 Lanes Area -->
                    <RowDefinition Height="Auto"/> <!-- Slider Area -->
                </Grid.RowDefinitions>
                
                <!-- (1) 마커 (Markers) : Multi-Lane 렌더링 방식 -->
                <ItemsControl ItemsSource="{Binding EventLanes}" Grid.Row="0" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <!-- 5개 레인을 위 아래로 쌓기 -->
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="35" Margin="0"> 
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/> <!-- 차선 이름 표시 영역 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- 차선 라벨 -->
                                <Grid Margin="0,0,10,0">
                                    <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Fill="{Binding EventType, Converter={StaticResource EventColorConverter}}"/>
                                    <TextBlock Text="{Binding LaneName}" Foreground="#888888" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                                           
                                <!-- 옅은 차선 가이드 선 -->
                                <Border Grid.Column="1" Height="1" Background="#333333" VerticalAlignment="Center" Margin="9,0"/>

                                <!-- 실질적인 해당 차선의 이벤트들 -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding LaneEvents}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Background="Transparent" ClipToBounds="False" Height="35" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource TimeToOffsetConverter}">
                                                        <!-- 이벤트 단일 객체이므로 바로 Timestamp -->
                                                        <Binding Path="Timestamp"/>
                                                        <Binding Path="DataContext.TotalDuration" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}"/>
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top" Value="7"/> <!-- 가운데 정렬을 위한 조정 (35-20)/2 + alpha -->
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="MarkerRoot" Width="20" Height="20">
                                                <Grid.RenderTransform>
                                                    <TranslateTransform X="-10"/>
                                                </Grid.RenderTransform>
                                                
                                                <Border x:Name="HitArea" Background="Transparent" Cursor="Hand"/>
                                                
                                                <ContentControl IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate>
                                                                        <Grid RenderTransformOrigin="0.5,0.5">
                                                                            <Grid.RenderTransform>
                                                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                                            </Grid.RenderTransform>
                                                                            <Rectangle x:Name="MarkerRect" Width="4" Height="16" Fill="{Binding EventType, Converter={StaticResource EventColorConverter}}" RadiusX="1" RadiusY="1">
                                                                                <Rectangle.Effect>
                                                                                    <DropShadowEffect x:Name="MarkerGlow" ShadowDepth="0" BlurRadius="2" Opacity="0.7" Color="White"/>
                                                                                </Rectangle.Effect>
                                                                            </Rectangle>
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard x:Name="ActiveStoryboard">
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.8" Duration="0:0:0.1" />
                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.1" />
                                                                                            <DoubleAnimation Storyboard.TargetName="MarkerGlow" Storyboard.TargetProperty="BlurRadius" To="12" Duration="0:0:0.1" />
                                                                                            <DoubleAnimation Storyboard.TargetName="MarkerGlow" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.1" />
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                                <DataTrigger.ExitActions>
                                                                                    <StopStoryboard BeginStoryboardName="ActiveStoryboard"/>
                                                                                </DataTrigger.ExitActions>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                                
                                                <!-- Popup: 다중 이벤트가 아닌 '단일 이벤트' (현재 Context) 모델의 정보를 그림 -->
                                                <Popup x:Name="EventPopup" 
                                                       PlacementTarget="{Binding ElementName=HitArea}"
                                                       Placement="Top"
                                                       AllowsTransparency="True"
                                                       StaysOpen="True"
                                                       VerticalOffset="8">
                                                        <Border BorderBrush="{Binding EventType, Converter={StaticResource EventColorConverter}}" BorderThickness="2" 
                                                                CornerRadius="6" Padding="12,8" MinWidth="200" MaxWidth="340">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#2D2D30" Offset="0"/>
                                                                    <GradientStop Color="#252526" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Border.Effect>
                                                                <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.6" Color="Black"/>
                                                            </Border.Effect>
                                                        
                                                        <StackPanel>
                                                            <!-- 그룹 헤더: Timestamp -->
                                                            <TextBlock Text="{Binding Timestamp, StringFormat='Time: {0:F2}s'}" 
                                                                       FontFamily="Consolas" FontSize="11" Foreground="#808080" 
                                                                       HorizontalAlignment="Right" Margin="0,0,0,8"/>
                                                            
                                                            <Rectangle Height="1" Fill="#3E3E42" Margin="0,0,0,8"/>

                                                            <!-- 사용자가 작성한 단일 이벤트 상세 요소 이식 -->
                                                            <Border Background="#333333" CornerRadius="4" Padding="8" BorderBrush="#444444" BorderThickness="1">
                                                                <StackPanel>
                                                                    <!-- Title -->
                                                                    <TextBlock Text="{Binding Title}" 
                                                                               Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"
                                                                               TextWrapping="Wrap" Margin="0,0,0,2"/>

                                                                    <!-- Description -->
                                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                                        <TextBlock Text="• " Foreground="White"/>
                                                                        <TextBlock>
                                                                            <Run Text="{Binding DescriptionLabel}" Foreground="White" FontWeight="Bold"/>     
                                                                            <Run Text=" : " Foreground="#AAAAAA"/>
                                                                            <Run Text="{Binding Description}" Foreground="White"/>
                                                                        </TextBlock>
                                                                    </StackPanel>

                                                                    <!-- RangeBTW -->
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <TextBlock Text="• " Foreground="White"/>
                                                                        <TextBlock>
                                                                            <Run Text="{Binding RangeBTWLabel}" Foreground="White" FontWeight="Bold"/>
                                                                            <Run Text=" : " Foreground="White"/>
                                                                            <Run Text="{Binding RangeBTW}" Foreground="White"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                                
                                                <Grid.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter" SourceName="HitArea">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <BooleanAnimationUsingKeyFrames Storyboard.TargetName="EventPopup" Storyboard.TargetProperty="IsOpen">
                                                                    <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                                                </BooleanAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave" SourceName="HitArea">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <BooleanAnimationUsingKeyFrames Storyboard.TargetName="EventPopup" Storyboard.TargetProperty="IsOpen">
                                                                    <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="False"/>
                                                                </BooleanAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Grid.Triggers>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl> 
                
                <!-- (1.5) 시각적 재생 가이드선 (Playhead Vertical Scanning Line) -->
                <!-- 전체 차선 영역(Grid.Row=0)과 슬라이더 영역(Grid.Row=1)을 세로로 관통하는 재생 스캐닝 선 -->
                <Canvas Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" Margin="80,0,0,0" Panel.ZIndex="10">
                    <!-- Background 투명 지정을 통해 Height 렌더링 확보 -->
                    <Border Background="Transparent" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"/>
                    
                    <!-- 플레이헤드 전체 그룹 -->
                    <Grid Width="100">
                        <Canvas.Left>
                            <MultiBinding Converter="{StaticResource TimeToOffsetConverter}">
                                <Binding Path="CurrentTime" />
                                <Binding Path="TotalDuration" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}"/>
                            </MultiBinding>
                        </Canvas.Left>
                        <Grid.RenderTransform>
                            <!-- Grid 너비를 100으로 고정 후 왼쪽으로 -50만큼 이동시키면, 
                                 Grid의 정가운데(내부 Center 정렬 요소들)가 정확히 Canvas.Left 오프셋 점에 맞춰집니다. -->
                            <TranslateTransform X="-50"/>
                        </Grid.RenderTransform>

                        <!-- 세로선 (매트 화이트) -->
                        <Rectangle Width="2" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}" 
                                   Fill="#FAFAFA" Opacity="0.5" HorizontalAlignment="Center">
                            <Rectangle.Effect>
                                <DropShadowEffect Color="#FAFAFA" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                            </Rectangle.Effect>
                        </Rectangle>
                        
                        <!-- 캡슐 모양 헤드 (Time Capsule) -->
                        <Border Background="#FAFAFA" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-12,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <TextBlock Text="{Binding CurrentTimeDisplay}" FontSize="9" FontWeight="Bold" Foreground="#2d2d2d" FontFamily="Consolas"/>
                        </Border>

                        <!-- 하단 재생바 떰브 (형광색 원형) -->
                        <Ellipse Width="14" Height="14" Fill="#333333" Stroke="#00BFFF" StrokeThickness="3"
                                 VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#00BFFF" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </Canvas>
                
                <!-- (2) 슬라이더 영역 -->
                <!-- 슬라이더 컨테이너에 Left Margin 80을 주어 위쪽 차선 캔버스(Column 1, Width 80 제외)와 가로 폭을 완벽히 동기화 -->
                <Grid Grid.Row="1" Margin="80,0,0,0">
                    <!-- 배경 트랙 (미니멀 화이트 라인) -->
                    <Border Height="1" Background="#555555" CornerRadius="0" VerticalAlignment="Center" Margin="9,0"/>
                
                    <!-- 실제 슬라이더 컨트롤 (투명화하여 드래그 기능만 유지) -->
                    <Slider Minimum="0" Maximum="{Binding TotalDuration}" 
                            Value="{Binding CurrentTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Height="30"
                            Background="Transparent" Opacity="0.01"/>
                </Grid>
            </Grid>

            <!-- Timeline (Grid.Row=0) is above this -->

            <!-- Spacer & Event Overlay (Grid.Row=1) -->
            <!-- Spacer & Event Overlay (Grid.Row=1) -->
            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- [수정] 스크롤 뷰어를 추가하여 높이 제한 및 잘림 방지 -->
                <!-- [수정] 스크롤 뷰어를 제거하고 단일 라인 요약 표시로 변경 -->
                <!-- 배경: 투명하지만 ToolTip 트리거를 위해 HitTestVisible 필요 -->
                <Grid Background="Transparent" VerticalAlignment="Center" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="10000">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <!-- PrimaryEvent가 null이면 숨김 -->
                                <DataTrigger Binding="{Binding PrimaryEvent}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- 사용자의 요약 UI 구조 유지 (DTO 매핑) -->
                    <!-- 사용자의 요약 UI 구조 유지 (DTO 매핑) -->
                    <Grid>
                        <!-- 단일 이벤트 패널 (중첩 없을 때만 표시) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExtraEventCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <!-- 메인 타이틀 -->
                            <TextBlock TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,5,0">
                                <Run Text="⚡ " Foreground="#FF5555" FontWeight="Bold"/> 
                                <Run Text="{Binding PrimaryEvent.Title}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            </TextBlock>

                            <!-- Description 데이터 전시 (Pill Glass Badge) -->
                            <Border Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="5,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrimaryEvent.Description}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PrimaryEvent.Description}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PrimaryEvent.DescriptionLabel}" Foreground="#BBBBBB" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PrimaryEvent.Description}" Foreground="#DDDDDD" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 마커 RTW (Range To Target) 동기화 전시 (Pill Glass Badge) -->
                            <Border Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="5,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrimaryEvent.RangeBTW}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PrimaryEvent.RangeBTW}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯 " Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PrimaryEvent.RangeBTWLabel}" Foreground="#BBBBBB" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PrimaryEvent.RangeBTW}" Foreground="#00FFCC" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 클러스터 요약형 패널 (중첩 이벤트 발생 시 표시) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <!-- 중첩이 없으면 숨김 -->
                                        <DataTrigger Binding="{Binding ExtraEventCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- 경고 아이콘 및 메시지 -->
                            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">
                                <Run Text="⚠️ " Foreground="#FFCC00" FontWeight="Bold"/>
                                <Run Text="다중 교전 이벤트 발생" Foreground="#FFCC00" FontWeight="Bold" FontSize="13"/>
                            </TextBlock>

                            <!-- 총 이벤트 갯수 배지 -->
                            <Border Background="#1AFFFFFF" BorderBrush="#FFCC00" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="5,0" VerticalAlignment="Center">
                                <TextBlock Foreground="White" FontWeight="Bold" FontSize="12">
                                    <Run Text="총 " Foreground="#AAAAAA"/>
                                    <!-- CurrentEvents.Count를 통해 총 이벤트 개수 표시 (읽기 전용이므로 Mode=OneWay 필수) -->
                                    <Run Text="{Binding CurrentEvents.Count, Mode=OneWay}" Foreground="#FFCC00" FontSize="13"/>
                                    <Run Text=" 건" Foreground="#AAAAAA"/>
                                </TextBlock>
                            </Border>

                            <!-- 안내 문구 -->
                            <TextBlock Text="(마우스를 올려 상세 확인)" Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 툴팁: 전체 리스트 표시 (중첩된 이벤트들의 모든 정보 전시) -->
                    <Grid.ToolTip>
                        <ToolTip Background="#222222" BorderBrush="#555555" BorderThickness="1" Foreground="White" Padding="6">
                            <ItemsControl ItemsSource="{Binding CurrentEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,4" HorizontalAlignment="Left">
                                            <!-- 이벤트 타이틀 -->
                                            <TextBlock TextAlignment="Left" VerticalAlignment="Center" Margin="0,0,5,0">
                                                <Run Text="⚡ " Foreground="#FF5555" FontWeight="Bold"/> 
                                                <Run Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                            </TextBlock>

                                            <!-- 설명 (Pill Glass Badge) -->
                                            <Border Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="5,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DescriptionLabel}" Foreground="#BBBBBB" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="#DDDDDD" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 표적거리/남은시간 (Pill Glass Badge) -->
                                            <Border Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="5,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RangeBTW}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RangeBTW}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🎯 " Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RangeBTWLabel}" Foreground="#BBBBBB" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding RangeBTW}" Foreground="#00FFCC" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ToolTip>
                    </Grid.ToolTip>
                </Grid>
            </Grid>

            <!-- Controls (Grid.Row=2) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- 이전/다음 -->
                    <ColumnDefinition Width="*"/>    <!-- 시간 표시 -->
                    <ColumnDefinition Width="Auto"/> <!-- 설정 -->
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" >
                    <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding StepEventCommand}" CommandParameter="-1" Content="⏮" ToolTip="이전 이벤트 (Ctrl+←)"/>
                    <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding StepCommand}" CommandParameter="-1" Content="◀" ToolTip="뒤로 이동 (←)"/>
                    <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding PlayPauseCommand}" Content="{Binding PlayButtonText}" MinWidth="80" FontWeight="Bold"/>
                    <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding StepCommand}" CommandParameter="1" Content="▶" ToolTip="앞으로 이동 (→)"/>
                    <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding StepEventCommand}" CommandParameter="1" Content="⏭" ToolTip="다음 이벤트 (Ctrl+→)"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTimeDisplay}" Foreground="{StaticResource TextPrimary}" FontSize="16" FontFamily="Consolas" FontWeight="Bold"/>
                    <TextBlock Text=" / " Foreground="{StaticResource TextSecondary}" FontSize="16" Margin="5,0"/>
                    <TextBlock Text="{Binding TotalTimeDisplay}" Foreground="{StaticResource TextSecondary}" FontSize="16" FontFamily="Consolas"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 렌더링 모드 토글 -->
                    <TextBlock Text="렌더링:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    
                    <!-- 현대적인 토글 스위치 (CheckBox 기반) -->
                    <CheckBox IsChecked="{Binding IsRealtimeRenderingEnabled}" VerticalAlignment="Center" Margin="0,0,15,0" MinWidth="100"
                              ToolTip="• 실시간: 모든 움직임 렌더링&#x0a;• 성능 우선: 이벤트 시점만 렌더링">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 토글 스위치 배경 -->
                                    <Border x:Name="SwitchTrack" Width="40" Height="20" CornerRadius="10" 
                                            Background="#555555" Cursor="Hand">
                                        <!-- 토글 원 (Thumb) -->
                                        <Ellipse x:Name="SwitchThumb" Width="16" Height="16" 
                                                 Fill="{StaticResource TextPrimary}" 
                                                 HorizontalAlignment="Left" Margin="2,0,0,0">
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Border>
                                    
                                    <!-- 상태 레이블 -->
                                    <TextBlock x:Name="StateLabel" Text="성능 우선" 
                                               Foreground="{StaticResource TextSecondary}" 
                                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                
                                <ControlTemplate.Triggers>
                                    <!-- Checked 상태 (실시간 렌더링 ON) -->
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentColor}"/>
                                        <Setter TargetName="StateLabel" Property="Text" Value="실시간"/>
                                        <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource AccentColor}"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ThumbTransform" 
                                                                     Storyboard.TargetProperty="X" 
                                                                     To="18" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ThumbTransform" 
                                                                     Storyboard.TargetProperty="X" 
                                                                     To="0" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    
                                    <!-- Hover 효과 -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SwitchThumb" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="White" Opacity="0.5"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                    
                    <TextBlock Text="재생 속도:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding PlaybackSpeedText, UpdateSourceTrigger=LostFocus}" Width="50" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    
                    <TextBlock Text="이동 간격:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBox Text="{Binding StepIntervalText, UpdateSourceTrigger=LostFocus}" Width="50" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                    <!-- 수동 시간 이동 (Time Jump) -->
                    <Rectangle Width="1" Height="16" Fill="#555555" Margin="15,0"/>
                    <TextBlock Text="시간 이동:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding JumpTargetTimeText, UpdateSourceTrigger=LostFocus}" Width="60" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding JumpToTimeCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding JumpToTimeCommand}" Content="➜" Margin="5,0,0,0" ToolTip="입력한 시간으로 이동 (Enter)"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <!-- Key Bindings -->
    <UserControl.InputBindings>
        <KeyBinding Key="Left" Command="{Binding StepCommand}" CommandParameter="-1"/>
        <KeyBinding Key="Right" Command="{Binding StepCommand}" CommandParameter="1"/>
        <KeyBinding Key="Left" Modifiers="Control" Command="{Binding StepEventCommand}" CommandParameter="-1"/>
        <KeyBinding Key="Right" Modifiers="Control" Command="{Binding StepEventCommand}" CommandParameter="1"/>
        <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}"/>
    </UserControl.InputBindings>
</UserControl>
