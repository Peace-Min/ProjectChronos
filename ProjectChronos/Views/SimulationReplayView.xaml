<UserControl x:Class="ProjectChronos.Views.SimulationReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjectChronos.Views"
             xmlns:vm="clr-namespace:ProjectChronos.ViewModels"
             xmlns:conv="clr-namespace:ProjectChronos.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="800">
    <UserControl.Resources>
        <local:TimeToOffsetConverter x:Key="TimeToOffsetConverter" ThumbWidth="18.0"/>
        <conv:PriorityToTagConverter x:Key="PriorityToTagConverter"/>

        <!-- 색상 리소스 -->
        <SolidColorBrush x:Key="PanelBackground" Color="#2d2d2d"/>
        <SolidColorBrush x:Key="WindowBackground" Color="#1e1e1e"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007acc"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ffffff"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#aaaaaa"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#444444"/>
        <SolidColorBrush x:Key="ControlHover" Color="#555555"/>
        <SolidColorBrush x:Key="ControlPressed" Color="#333333"/>
        
        <!-- 버튼 스타일 -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 슬라이더 스타일 -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- 트랙 (배경 투명 - 별도 Border로 위임) -->
                            <Border x:Name="TrackBackground" Grid.Row="1" Height="4" 
                                    Background="Transparent" CornerRadius="2" VerticalAlignment="Center"/>
                            
                            <!-- 선택 범위 (진행률) -->
                            <!-- 참고: 표준 WPF Slider는 PART_SelectionRange 없이 0부터 값까지의 '선택' 범위를 시각적으로 쉽게 지원하지 않습니다.
                                 간단하게 하기 위해 기본 트랙을 사용하되 썸(Thumb) 스타일을 적용합니다.
                                 '채워진' 느낌을 주려면 PART_SelectionRange나 별도 바인딩이 포함된 복잡한 템플릿이 필요합니다.
                                 여기서는 안정성을 위해 깔끔한 트랙과 썸을 유지합니다. -->
                            
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{StaticResource AccentColor}" Height="4" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2,0,0,2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" Height="4" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="18" Height="18" VerticalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{StaticResource TextPrimary}" Stroke="{StaticResource AccentColor}" StrokeThickness="2"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 콤보박스 스타일 (기본 다크) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="Foreground" Value="Black"/> <!-- Content usually black unless specific template -->
            <Setter Property="BorderBrush" Value="#666"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlPressed}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- 툴팁 스타일 -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="5" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    
    <Border Background="{StaticResource PanelBackground}" Padding="15" CornerRadius="8" Effect="{x:Null}">
        <!-- Optional Shadow Effect if desired, removed for clean look -->
        <!-- <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect> -->
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Timeline -->
                <RowDefinition Height="20"/>   <!-- Spacer -->
                <RowDefinition Height="Auto"/> <!-- Controls -->
            </Grid.RowDefinitions>

            <!-- 타임라인 영역 -->
            <!-- 
                 [구조 설명]
                 ItemsControl (마커)과 Slider의 상호작용을 위해 Z-Index를 신중하게 설정해야 합니다.
                 
                 - 마커(Markers)는 시각적으로 트랙 위에 표시되어야 합니다.
                 - 슬라이더(Slider)는 사용자가 드래그할 수 있어야 하므로 최상단에 위치해야 합니다.
                 - 그러나 슬라이더의 배경(Track)이 마커를 가리면 안 되므로, 슬라이더 배경을 투명하게 처리합니다.
            -->
            <Grid Grid.Row="0" Margin="0,0">
                <!-- 
                    [Z-Index 계층 구조 (Layering)]
                    1. Track Box (Z=1): 슬라이더의 시각적 배경 트랙입니다. (실제 Slider 트랙은 투명)
                    2. Markers (Z=2): 이벤트 마커들이 트랙 위에 그려집니다.
                    3. Slider (Z=3): 투명한 트랙과 조작 가능한 썸(Thumb)이 가장 위에 위치합니다.
                                     Background="{x:Null}"로 설정하여 마우스가 빈 공간에서는 아래의 마커 툴팁에 닿을 수 있게 합니다.
                -->
                
                <!-- 1. 배경 트랙 (Visual Only) -->
                <!-- Slider의 Margin/Padding을 고려하여 수평 정렬. Slider가 꽉 차있으므로 Margin="9,0" (Thumb 반경 고려) -->
                <Border Height="4" Background="#555555" CornerRadius="2" VerticalAlignment="Center" Panel.ZIndex="1" Margin="9,0"/>

                <!-- 2. 마커 (Events) -->
                <ItemsControl ItemsSource="{Binding Events}" Panel.ZIndex="2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="Transparent" ClipToBounds="False" Height="30" VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource TimeToOffsetConverter}">
                                        <Binding Path="Timestamp"/>
                                        <Binding Path="DataContext.TotalDuration" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Canvas.Top" Value="7"/> 
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Tag="{Binding Priority, Converter={StaticResource PriorityToTagConverter}}"
                                            Cursor="Hand" ToolTip="{Binding Description}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <!-- 기본 마커 모양 (Tick Mark) -->
                                                    <Grid Margin="-2,0,0,0">
                                                        <Rectangle Width="4" Height="16" Fill="#8be9fd" RadiusX="1" RadiusY="1">
                                                            <Rectangle.Effect>
                                                                <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.5"/>
                                                            </Rectangle.Effect>
                                                        </Rectangle>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- 중요도: Critical (빨강) -->
                                            <Trigger Property="Tag" Value="Critical">
                                                <Setter Property="Panel.ZIndex" Value="100"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <Grid Margin="-2.5,0,0,0">
                                                                <Rectangle Width="5" Height="16" Fill="#ff5555" RadiusX="1" RadiusY="1" Stroke="White" StrokeThickness="1">
                                                                    <Rectangle.Effect>
                                                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.6"/>
                                                                    </Rectangle.Effect>
                                                                </Rectangle>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <!-- 중요도: Warning (주황) -->
                                            <Trigger Property="Tag" Value="Warning">
                                                <Setter Property="Panel.ZIndex" Value="50"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <Grid Margin="-2,0,0,0">
                                                                <Rectangle Width="4" Height="16" Fill="#ffb86c" RadiusX="1" RadiusY="1">
                                                                    <Rectangle.Effect>
                                                                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.5"/>
                                                                    </Rectangle.Effect>
                                                                </Rectangle>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- 3. 슬라이더 (Z=3, Transparent Track) -->
                <!-- 
                     Background="{x:Null}": 슬라이더의 빈 영역(트랙 주변)이 마우스 이벤트를 통과시키도록 합니다 (HitTestVisible=False 효과와 유사).
                     이로써 밑에 있는 마커(Z=2)의 돌출된 부분에 마우스 호버(툴팁) 이벤트가 도달할 수 있습니다.
                     단, Thumb와 실제 컨트롤 영역은 여전히 상호작용 가능합니다.
                -->
                <Slider Style="{StaticResource ModernSliderStyle}"
                        Minimum="0" Maximum="{Binding TotalDuration}" 
                        Value="{Binding CurrentTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center"
                        Panel.ZIndex="3"
                        Background="{x:Null}"/>
            </Grid>

            <!-- 컨트롤 영역 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- 이전/다음 -->
                    <ColumnDefinition Width="*"/>    <!-- 시간 표시 -->
                    <ColumnDefinition Width="Auto"/> <!-- 설정 -->
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" >
                    <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding StepEventCommand}" CommandParameter="-1" Content="⏮ 이벤트" ToolTip="이전 이벤트 (Ctrl+Left)"/>
                    <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding StepCommand}" CommandParameter="-1" Content="◀ 스텝" ToolTip="이전 스텝 (Left)"/>
                    <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding PlayPauseCommand}" Content="{Binding PlayButtonText}" MinWidth="80" FontWeight="Bold"/>
                    <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding StepCommand}" CommandParameter="1" Content="스텝 ▶" ToolTip="다음 스텝 (Right)"/>
                    <Button Style="{StaticResource ModernButtonStyle}" Command="{Binding StepEventCommand}" CommandParameter="1" Content="이벤트 ⏭" ToolTip="다음 이벤트 (Ctrl+Right)"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTimeDisplay}" Foreground="{StaticResource TextPrimary}" FontSize="16" FontFamily="Consolas" FontWeight="Bold"/>
                    <TextBlock Text=" / " Foreground="{StaticResource TextSecondary}" FontSize="16" Margin="5,0"/>
                    <TextBlock Text="{Binding TotalTimeDisplay}" Foreground="{StaticResource TextSecondary}" FontSize="16" FontFamily="Consolas"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="배속:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding PlaybackSpeedText, UpdateSourceTrigger=LostFocus}" Width="50" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    
                    <TextBlock Text="간격:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBox Text="{Binding StepIntervalText, UpdateSourceTrigger=LostFocus}" Width="50" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

    <!-- Key Bindings -->
    <UserControl.InputBindings>
        <KeyBinding Key="Left" Command="{Binding StepCommand}" CommandParameter="-1"/>
        <KeyBinding Key="Right" Command="{Binding StepCommand}" CommandParameter="1"/>
        <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}"/>
    </UserControl.InputBindings>
</UserControl>
