<UserControl x:Class="ProjectChronos.Views.ReportTimelineExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="600"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111111"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#111111"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#CCD7E2"/>
        <SolidColorBrush x:Key="BaselineBrush" Color="#0072BD"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#9FB0C2"/>
        <SolidColorBrush x:Key="CardDividerBrush" Color="#B5C1CD"/>
        <SolidColorBrush x:Key="CardLabelBrush" Color="#4B5F74"/>
        <SolidColorBrush x:Key="FooterFillBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="FooterBorderBrush" Color="#9FB0C2"/>
    </UserControl.Resources>

    <Border Background="White"
            Width="{Binding RenderedCanvasWidth}"
            Height="{Binding RenderedCanvasHeight}">
        <Grid Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Canvas Width="{Binding TimelineWidth}"
                        Height="{Binding OverviewHeight}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                    <Line X1="{Binding BaselineStartX}"
                          X2="{Binding BaselineEndX}"
                          Y1="{Binding BaselineY}"
                          Y2="{Binding BaselineY}"
                          Stroke="{StaticResource BaselineBrush}"
                          StrokeThickness="4.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                    <TextBlock Canvas.Left="{Binding AxisLabelLeft}"
                               Canvas.Top="{Binding AxisLabelTop}"
                               Text="{Binding AxisLabelText}"
                               FontFamily="Segoe UI"
                               FontSize="{Binding AxisLabelFontSize}"
                               FontWeight="Regular"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <ItemsControl ItemsSource="{Binding IntervalAnchorItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line X1="0"
                                      X2="0"
                                      Y1="0"
                                      Y2="{Binding Height}"
                                      Stroke="{Binding Stroke}"
                                      StrokeThickness="1.5"
                                      StrokeDashArray="2,4"
                                      StrokeStartLineCap="Flat"
                                      StrokeEndLineCap="Flat"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding IntervalItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas Width="{Binding Width}"
                                        Height="{Binding Height}">
                                    <Path Data="{Binding FrameGeometry}"
                                          Stroke="{Binding Stroke}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Path Data="{Binding ArrowGeometry}"
                                          Stroke="{Binding Stroke}"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Miter"
                                          StrokeStartLineCap="Flat"
                                          StrokeEndLineCap="Flat">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowChevronHeads}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding Label}"
                                               Canvas.Left="{Binding LabelLeft}"
                                               Canvas.Top="0"
                                               FontFamily="Segoe UI"
                                               FontSize="{Binding FontSize}"
                                               FontWeight="Bold"
                                               Foreground="{Binding Stroke}"/>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding SlotItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas Width="{Binding Width}"
                                        Height="{Binding Height}">
                                    <Ellipse Canvas.Left="{Binding NodeLeft}"
                                             Canvas.Top="{Binding NodeTop}"
                                             Width="{Binding NodeDiameter}"
                                             Height="{Binding NodeDiameter}"
                                             Fill="White"
                                             Stroke="{StaticResource BaselineBrush}"
                                             StrokeThickness="2.2"/>
                                    <Border Canvas.Left="{Binding TimeLeft}"
                                            Canvas.Top="{Binding TimeTop}"
                                            Background="White">
                                        <TextBlock Text="{Binding TimeText}"
                                                   FontFamily="Consolas"
                                                   FontSize="{Binding TimeFontSize}"
                                                   FontWeight="Regular"
                                                   Foreground="{Binding TimeForeground}"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap"/>
                                    </Border>

                                    <Border Canvas.Left="{Binding TitleLeft}"
                                            Canvas.Top="{Binding TitleTop}"
                                            Width="{Binding TitleWidth}"
                                            Background="Transparent">
                                        <ItemsControl ItemsSource="{Binding Titles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="{Binding Width}"
                                                                Margin="{Binding Margin}">
                                                        <TextBlock Text="{Binding TitleText}"
                                                                   Width="{Binding Width}"
                                                                   FontFamily="Segoe UI"
                                                                   FontSize="{Binding TitleFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding TitleForeground}"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Canvas>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,8,0,0">
                <Canvas Width="{Binding TimelineWidth}"
                        Height="{Binding DetailBandHeight}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                    <ItemsControl ItemsSource="{Binding DetailCardItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        Padding="{Binding ContentPadding}"
                                        Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0">
                                    <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       Width="{Binding TextContentWidth}"
                                                       Margin="{Binding TitleMargin}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="{Binding TitleFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Rectangle Height="1"
                                                       Margin="{Binding DividerMargin}"
                                                       Fill="{StaticResource CardDividerBrush}"/>
                                            <ItemsControl ItemsSource="{Binding Fields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="{Binding Width}"
                                                                    Margin="{Binding Margin}">
                                                            <TextBlock Text="{Binding Label}"
                                                                       Width="{Binding Width}"
                                                                       FontFamily="Segoe UI"
                                                                       FontSize="{Binding LabelFontSize}"
                                                                       Foreground="{StaticResource CardLabelBrush}"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Value}"
                                                                       Width="{Binding ValueWidth}"
                                                                       Margin="{Binding ValueMargin}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="{Binding ValueFontSize}"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>

            <Border Grid.Row="2"
                    Width="{Binding FooterWidth}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,34,0,0"
                    Padding="34,24"
                    Visibility="{Binding HasFooterNotes, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{StaticResource FooterFillBrush}"
                    BorderBrush="{StaticResource FooterBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="0">
                <ItemsControl ItemsSource="{Binding FooterNotes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Margin="0,0,0,8"
                                       FontFamily="Segoe UI"
                                       FontSize="28"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Border>
</UserControl>
